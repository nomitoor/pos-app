# Copy this file to .env.prod (the shop's real app) and .env.dev (testing),
# and fill in each one's Supabase project.
# Dashboard → Project Settings → Data API (URL) and → API Keys (publishable key).
# Never put the "secret" / "service_role" key here.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# prod or dev. dev shows a "DEV" badge in the corner of the app.
APP_ENV=prod
